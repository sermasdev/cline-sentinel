# CLINE SENTINEL Environment Configuration Template

# General
ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000
COWRIE_PORT=2222
WEB_DECOY_PORT=8088

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/sentinel

# Cline Autonomous AI Runtime
CLINE_EXECUTABLE=/home/admin/.local/bin/cline
CLINE_PROVIDER=openrouter
CLINE_MODEL=google/gemini-3.8-flash
CLINE_TIMEOUT_SECONDS=60
CLINE_MAX_CONCURRENCY=2
CLINE_MOCK_MODE=false

# Composio Alerts (Gmail)
COMPOSIO_ENABLED=false
COMPOSIO_MOCK_MODE=true
ALERT_EMAIL_RECIPIENT=secops-alerts@example.com
ENABLE_REAL_EMAIL=false

# Parallel.ai Threat Intelligence
PARALLEL_ENABLED=false
PARALLEL_MOCK_MODE=true
PARALLEL_API_KEY=

# Security Controls
ENABLE_TRAFFIC_DIVERSION=false
